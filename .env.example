# Copy this file to .env and adjust values (never commit .env)

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=de_user
POSTGRES_PASSWORD=de_password
POSTGRES_DB=us_accidents
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Source data ---
# Local CSV path. If the file is missing, ingest.py downloads it from Kaggle
# (needs ~/.kaggle/kaggle.json or KAGGLE_USERNAME / KAGGLE_KEY).
CSV_PATH=data/US_Accidents_March23_120k.csv
KAGGLE_DATASET=sobhanmoosavi/us-accidents
ROW_LIMIT=120000

# --- Google Sheets ---
GOOGLE_CREDENTIALS_FILE=credentials.json
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
